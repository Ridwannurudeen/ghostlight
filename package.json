{
  "name": "ghostlight",
  "version": "1.0.0",
  "description": "Asynchronous social charades performed by real Decentraland player ghosts",
  "scripts": {
    "start": "sdk-commands start",
    "deploy": "sdk-commands deploy",
    "build": "sdk-commands build",
    "preflight": "node tools/preflight.mjs",
    "test": "vitest run",
    "assets:models": "call \"C:\\Program Files\\Blender Foundation\\Blender 5.1\\blender.exe\" -b --python tools/blender/build_assets.py",
    "assets:sounds": "python tools/audio/build_sounds.py",
    "assets:ui": "python tools/ui/build_textures.py",
    "assets": "npm run assets:models && npm run assets:sounds && npm run assets:ui",
    "upgrade-sdk": "npm install --save-dev @dcl/sdk@latest",
    "upgrade-sdk:next": "npm install --save-dev @dcl/sdk@next",
    "server-logs": "sdk-commands sdk-server-logs"
  },
  "devDependencies": {
    "@dcl/js-runtime": "7.27.1-33086747846.commit-824d240",
    "@dcl/sdk": "7.27.1-33086747846.commit-824d240",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0",
    "npm": ">=10.0.0"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "printWidth": 120,
    "trailingComma": "none"
  }
}
